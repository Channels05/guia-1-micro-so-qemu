     1                                  ; =============================================================================
     2                                  ;  boot_f2.asm - Guía 1, Fase 2: etapa 1 (sector de arranque de 512 bytes)
     3                                  ;
     4                                  ;  1. Inicializa segmentos y pila, guarda la unidad de arranque (DL).
     5                                  ;  2. Lee la etapa 2 desde el disquete con INT 13h AH=02h (direccionamiento
     6                                  ;     CHS), con hasta 3 intentos y reinicio de la controladora entre ellos.
     7                                  ;  3. Comprueba la firma "ETP2" al inicio de lo leído.
     8                                  ;  4. Transfiere el control a la etapa 2 (salto lejano a 0000:8004).
     9                                  ;  Ante un error de lectura o de firma muestra un mensaje y detiene la CPU.
    10                                  ; =============================================================================
    11                                  
    12                                  bits 16
    13                                  org 0x7C00
    14                                  
    15                                  %include "disposicion.inc"
     1                              <1> ; =============================================================================
     2                              <1> ;  disposicion.inc - Mapa de la imagen de disco e interfaz entre etapas
     3                              <1> ;  (única fuente de verdad: la incluyen ambas etapas y la lee scripts/build.sh)
     4                              <1> ;
     5                              <1> ;  Imagen: disquete de 1,44 MB = 2880 sectores de 512 bytes
     6                              <1> ;          geometría CHS 80 cilindros x 2 cabezas x 18 sectores por pista
     7                              <1> ;
     8                              <1> ;    LBA 0          CHS 0/0/1        etapa 1  (boot_f2.bin, 512 B, firma AA55)
     9                              <1> ;    LBA 1..16      CHS 0/0/2..17    etapa 2  (etapa2_f2.bin, 16 sectores
    10                              <1> ;                                              = 8 KiB reservados)
    11                              <1> ;    LBA 17..2879   resto            sin uso (ceros)
    12                              <1> ;
    13                              <1> ;  Interfaz etapa 1 -> etapa 2:
    14                              <1> ;    - la etapa 2 se carga en ETAPA2_SEG:ETAPA2_OFF (0000:8000)
    15                              <1> ;    - sus 4 primeros bytes son la firma ETAPA2_FIRMA ("ETP2"); la etapa 1 la
    16                              <1> ;      comprueba antes de saltar y, si no coincide, muestra un error
    17                              <1> ;    - el punto de entrada es ETAPA2_OFF + 4
    18                              <1> ;    - estado de la CPU al entrar: modo real 16 bits, CS = DS = ES = SS = 0,
    19                              <1> ;      SP = 0x7C00, interrupciones habilitadas, DL = unidad de arranque (BIOS)
    20                              <1> ; =============================================================================
    21                              <1> 
    22                              <1> ETAPA2_LBA       equ 1
    23                              <1> ETAPA2_SECTORES  equ 16
    24                              <1> ETAPA2_SEG       equ 0x0000
    25                              <1> ETAPA2_OFF       equ 0x8000
    26                              <1> ETAPA2_FIRMA     equ 'ETP2'
    27                              <1> 
    28                              <1> SECTORES_PISTA   equ 18
    29                              <1> 
    30                              <1> ; La etapa 1 lee con una única llamada CHS (cilindro 0, cabeza 0), así que la
    31                              <1> ; etapa 2 debe caber en la primera pista.
    32                              <1> %if ETAPA2_LBA + ETAPA2_SECTORES > SECTORES_PISTA
    33                              <1>     %error "La etapa 2 no cabe en la primera pista del disquete"
    34                              <1> %endif
    16                                  
    17                                  INTENTOS    equ 3
    18                                  
    19                                  inicio:
    20 00000000 FA                          cli
    21 00000001 31C0                        xor ax, ax
    22 00000003 8ED8                        mov ds, ax
    23 00000005 8EC0                        mov es, ax
    24 00000007 8ED0                        mov ss, ax
    25 00000009 BC007C                      mov sp, 0x7C00
    26 0000000C FB                          sti
    27 0000000D FC                          cld
    28 0000000E 8816[AE00]                  mov [unidad], dl            ; el BIOS informa la unidad de arranque en DL
    29                                  
    30 00000012 B80300                      mov ax, 0x0003              ; modo texto 80x25 (limpia la pantalla)
    31 00000015 CD10                        int 0x10
    32                                  
    33 00000017 BE[AF00]                    mov si, msg_carga
    34 0000001A E86A00                      call imprimir
    35                                  
    36 0000001D BF0300                      mov di, INTENTOS
    37                                  leer:
    38 00000020 B80000                      mov ax, ETAPA2_SEG
    39 00000023 8EC0                        mov es, ax
    40 00000025 BB0080                      mov bx, ETAPA2_OFF          ; ES:BX = destino
    41 00000028 B402                        mov ah, 0x02                ; INT 13h AH=02h: leer sectores (CHS)
    42 0000002A B010                        mov al, ETAPA2_SECTORES     ; cantidad de sectores
    43 0000002C B500                        mov ch, 0                   ; cilindro 0
    44 0000002E B102                        mov cl, ETAPA2_LBA + 1      ; sector (en CHS se numeran desde 1)
    45 00000030 B600                        mov dh, 0                   ; cabeza 0
    46 00000032 8A16[AE00]                  mov dl, [unidad]
    47 00000036 CD13                        int 0x13
    48 00000038 731C                        jnc leido                   ; CF = 0 -> lectura correcta
    49                                  
    50 0000003A 50                          push ax                     ; AH = código de error del BIOS
    51 0000003B 30E4                        xor ah, ah                  ; INT 13h AH=00h: reiniciar la controladora
    52 0000003D 8A16[AE00]                  mov dl, [unidad]
    53 00000041 CD13                        int 0x13
    54 00000043 58                          pop ax
    55 00000044 4F                          dec di
    56 00000045 75D9                        jnz leer
    57                                  
    58 00000047 50                          push ax                     ; se agotaron los intentos
    59 00000048 BE[5201]                    mov si, msg_err_lectura
    60 0000004B E83900                      call imprimir
    61 0000004E 58                          pop ax
    62 0000004F 88E0                        mov al, ah
    63 00000051 E84100                      call imprimir_hex
    64 00000054 EB2D                        jmp detener
    65                                  
    66                                  leido:
    67 00000056 66813E008045545032          cmp dword [ETAPA2_OFF], ETAPA2_FIRMA
    68 0000005F 751C                        jne firma_invalida
    69                                  
    70 00000061 BE[1A01]                    mov si, msg_ok
    71 00000064 E82000                      call imprimir
    72                                  
    73 00000067 A16C04                      mov ax, [0x046C]            ; contador de ticks del BIOS (18,2 por segundo)
    74 0000006A 83C024                      add ax, 36                  ; pausa de ~2 s para que el mensaje se vea
    75                                  .pausa:
    76 0000006D F4                          hlt
    77 0000006E 3B066C04                    cmp ax, [0x046C]
    78 00000072 75F9                        jne .pausa
    79                                  
    80 00000074 8A16[AE00]                  mov dl, [unidad]            ; interfaz: DL = unidad de arranque
    81 00000078 EA04800000                  jmp ETAPA2_SEG:ETAPA2_OFF + 4
    82                                  
    83                                  firma_invalida:
    84 0000007D BE[7F01]                    mov si, msg_err_firma
    85 00000080 E80400                      call imprimir
    86                                  
    87                                  detener:
    88 00000083 FA                          cli
    89                                  .espera:
    90 00000084 F4                          hlt
    91 00000085 EBFD                        jmp .espera
    92                                  
    93                                  ; --- imprimir: escribe la cadena DS:SI terminada en 0 (INT 10h AH=0Eh) ------
    94                                  imprimir:
    95 00000087 AC                          lodsb
    96 00000088 84C0                        test al, al
    97 0000008A 7408                        jz .fin
    98 0000008C B40E                        mov ah, 0x0E
    99 0000008E 30FF                        xor bh, bh
   100 00000090 CD10                        int 0x10
   101 00000092 EBF3                        jmp imprimir
   102                                  .fin:
   103 00000094 C3                          ret
   104                                  
   105                                  ; --- imprimir_hex: escribe AL como dos dígitos hexadecimales ----------------
   106                                  imprimir_hex:
   107 00000095 50                          push ax
   108 00000096 C0E804                      shr al, 4
   109 00000099 E80300                      call .digito
   110 0000009C 58                          pop ax
   111 0000009D 240F                        and al, 0x0F
   112                                  .digito:
   113 0000009F 0430                        add al, '0'
   114 000000A1 3C39                        cmp al, '9'
   115 000000A3 7602                        jbe .poner
   116 000000A5 0407                        add al, 7                   ; 'A' - '9' - 1
   117                                  .poner:
   118 000000A7 B40E                        mov ah, 0x0E
   119 000000A9 30FF                        xor bh, bh
   120 000000AB CD10                        int 0x10
   121 000000AD C3                          ret
   122                                  
   123 000000AE 00                      unidad          db 0
   124 000000AF 5B657461706120315D-     msg_carga       db "[etapa 1] Sector de arranque en 0000:7C00", 13, 10
   124 000000B8 20536563746F722064-
   124 000000C1 6520617272616E7175-
   124 000000CA 6520656E2030303030-
   124 000000D3 3A374330300D0A     
   125 000000DA 5B657461706120315D-                     db "[etapa 1] Leyendo etapa 2: LBA 1, 16 sectores -> 0000:8000 ... ", 0
   125 000000E3 204C6579656E646F20-
   125 000000EC 657461706120323A20-
   125 000000F5 4C424120312C203136-
   125 000000FE 20736563746F726573-
   125 00000107 202D3E20303030303A-
   125 00000110 38303030202E2E2E20-
   125 00000119 00                 
   126 0000011A 4F4B0D0A5B65746170-     msg_ok          db "OK", 13, 10, "[etapa 1] Firma ETP2 correcta, saltando a 0000:8004", 0
   126 00000123 6120315D204669726D-
   126 0000012C 61204554503220636F-
   126 00000135 7272656374612C2073-
   126 0000013E 616C74616E646F2061-
   126 00000147 20303030303A383030-
   126 00000150 3400               
   127 00000152 4552524F520D0A5B65-     msg_err_lectura db "ERROR", 13, 10, "[etapa 1] Fallo INT 13h, codigo AH=0x", 0
   127 0000015B 7461706120315D2046-
   127 00000164 616C6C6F20494E5420-
   127 0000016D 3133682C20636F6469-
   127 00000176 676F2041483D307800 
   128 0000017F 4552524F520D0A5B65-     msg_err_firma   db "ERROR", 13, 10, "[etapa 1] Firma ETP2 no encontrada: no hay etapa 2", 13, 10
   128 00000188 7461706120315D2046-
   128 00000191 69726D612045545032-
   128 0000019A 206E6F20656E636F6E-
   128 000001A3 74726164613A206E6F-
   128 000001AC 206861792065746170-
   128 000001B5 6120320D0A         
   129 000001BA 5B657461706120315D-                     db "[etapa 1] Sistema detenido.", 0
   129 000001C3 2053697374656D6120-
   129 000001CC 646574656E69646F2E-
   129 000001D5 00                 
   130                                  
   131 000001D6 00<rep 28h>             times 510 - ($ - $$) db 0
   132 000001FE 55AA                    dw 0xAA55
