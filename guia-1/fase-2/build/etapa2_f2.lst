     1                                  ; =============================================================================
     2                                  ;  etapa2_f2.asm - Guía 1, Fase 2: segunda etapa con dibujo ASCII y menú
     3                                  ;
     4                                  ;  La carga la etapa 1 en 0000:8000 (ver disposicion.inc). Muestra una barra
     5                                  ;  que identifica la etapa, el caballo de la Fase 1 y un menú:
     6                                  ;     [1] Información del sistema    (INT 12h, INT 15h AH=88h, INT 10h AH=0Fh)
     7                                  ;     [2] Galope del caballo         (animación: redibuja y avanza 2 columnas)
     8                                  ;     [3] Fecha y hora               (reloj de tiempo real, INT 1Ah)
     9                                  ;     [0] Detener el sistema         (CLI + HLT)
    10                                  ;  Cualquier otra tecla muestra un aviso y se vuelve a pedir la opción.
    11                                  ;
    12                                  ;  Servicios BIOS usados:
    13                                  ;     INT 16h AH=00h  esperar tecla (AL = ASCII, AH = código de rastreo)
    14                                  ;     INT 10h AH=02h  mover cursor        AH=09h  escribir carácter + color
    15                                  ;     INT 10h AH=06h  limpiar una ventana
    16                                  ;
    17                                  ;  Convención de registros en las rutinas de pantalla:
    18                                  ;     DH:DL = fila:columna del cursor, BL = color actual, BH = página 0
    19                                  ; =============================================================================
    20                                  
    21                                  bits 16
    22                                  
    23                                  %include "disposicion.inc"
     1                              <1> ; =============================================================================
     2                              <1> ;  disposicion.inc - Mapa de la imagen de disco e interfaz entre etapas
     3                              <1> ;  (única fuente de verdad: la incluyen ambas etapas y la lee scripts/build.sh)
     4                              <1> ;
     5                              <1> ;  Imagen: disquete de 1,44 MB = 2880 sectores de 512 bytes
     6                              <1> ;          geometría CHS 80 cilindros x 2 cabezas x 18 sectores por pista
     7                              <1> ;
     8                              <1> ;    LBA 0          CHS 0/0/1        etapa 1  (boot_f2.bin, 512 B, firma AA55)
     9                              <1> ;    LBA 1..16      CHS 0/0/2..17    etapa 2  (etapa2_f2.bin, 16 sectores
    10                              <1> ;                                              = 8 KiB reservados)
    11                              <1> ;    LBA 17..2879   resto            sin uso (ceros)
    12                              <1> ;
    13                              <1> ;  Interfaz etapa 1 -> etapa 2:
    14                              <1> ;    - la etapa 2 se carga en ETAPA2_SEG:ETAPA2_OFF (0000:8000)
    15                              <1> ;    - sus 4 primeros bytes son la firma ETAPA2_FIRMA ("ETP2"); la etapa 1 la
    16                              <1> ;      comprueba antes de saltar y, si no coincide, muestra un error
    17                              <1> ;    - el punto de entrada es ETAPA2_OFF + 4
    18                              <1> ;    - estado de la CPU al entrar: modo real 16 bits, CS = DS = ES = SS = 0,
    19                              <1> ;      SP = 0x7C00, interrupciones habilitadas, DL = unidad de arranque (BIOS)
    20                              <1> ; =============================================================================
    21                              <1> 
    22                              <1> ETAPA2_LBA       equ 1
    23                              <1> ETAPA2_SECTORES  equ 16
    24                              <1> ETAPA2_SEG       equ 0x0000
    25                              <1> ETAPA2_OFF       equ 0x8000
    26                              <1> ETAPA2_FIRMA     equ 'ETP2'
    27                              <1> 
    28                              <1> SECTORES_PISTA   equ 18
    29                              <1> 
    30                              <1> ; La etapa 1 lee con una única llamada CHS (cilindro 0, cabeza 0), así que la
    31                              <1> ; etapa 2 debe caber en la primera pista.
    32                              <1> %if ETAPA2_LBA + ETAPA2_SECTORES > SECTORES_PISTA
    33                              <1>     %error "La etapa 2 no cabe en la primera pista del disquete"
    34                              <1> %endif
    24                                  %include "video.inc"
     1                              <1> ; =============================================================================
     2                              <1> ;  video.inc - Colores del modo texto y códigos del formato de dibujo
     3                              <1> ;
     4                              <1> ;  Formato de flujo de bytes (el mismo de la Fase 1):
     5                              <1> ;    0x00            fin
     6                              <1> ;    0x0A (NL)       salto de línea: fila + 1, columna = margen inicial
     7                              <1> ;    0x01..0x1F      (excepto 0x0A) avanzar N columnas sin escribir
     8                              <1> ;    0x80..0xFF      cambiar color: atributo = byte & 0x7F
     9                              <1> ;    resto           carácter imprimible
    10                              <1> ;  Por eso los textos no usan tildes: en UTF-8 serían bytes >= 0x80.
    11                              <1> ; =============================================================================
    12                              <1> 
    13                              <1> CAFE        equ 0x06
    14                              <1> GRIS        equ 0x07
    15                              <1> AZUL_CLARO  equ 0x09
    16                              <1> VERDE       equ 0x0A
    17                              <1> CIAN        equ 0x0B
    18                              <1> ROJO        equ 0x04
    19                              <1> ROJO_CLARO  equ 0x0C
    20                              <1> AMARILLO    equ 0x0E
    21                              <1> BLANCO      equ 0x0F
    22                              <1> BARRA_SUP   equ 0x1F            ; blanco sobre azul
    23                              <1> BARRA_INF   equ 0x70            ; negro sobre gris
    24                              <1> 
    25                              <1> %define C(a)  (0x80 | (a))
    26                              <1> %define NL    10
    25                                  
    26                                  org ETAPA2_OFF
    27                                  
    28                                  FILA_MSG    equ 17              ; zona de respuestas: filas 17..23
    29                                  FILA_VOLVER equ 23
    30                                  COL_MSG     equ 4
    31                                  FILA_GALOPE equ 5               ; fila superior del caballo en la animación
    32                                  
    33                                  ; ESCRIBIR fila, columna, etiqueta: dibuja un flujo de bytes en esa posición
    34                                  %macro ESCRIBIR 3
    35                                      mov dx, ((%1) << 8) | (%2)
    36                                      mov si, %3
    37                                      call dibujar
    38                                  %endmacro
    39                                  
    40                                  ; -----------------------------------------------------------------------------
    41                                  cabecera:
    42 00000000 45545032                    dd ETAPA2_FIRMA             ; la etapa 1 verifica estos 4 bytes
    43                                  
    44                                  entrada:                        ; ETAPA2_OFF + 4
    45 00000004 31C0                        xor ax, ax
    46 00000006 8ED8                        mov ds, ax
    47 00000008 8EC0                        mov es, ax
    48 0000000A FC                          cld
    49 0000000B 8816[A107]                  mov [unidad], dl            ; interfaz: DL = unidad de arranque
    50 0000000F 31DB                        xor bx, bx                  ; BH = página 0 en todas las llamadas
