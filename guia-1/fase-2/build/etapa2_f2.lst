   260                                  ; =============================================================================
   261                                  ;  Rutinas de pantalla
   262                                  ; =============================================================================
   263                                  
   264                                  ; cursor: mueve el cursor a DH:DL (INT 10h AH=02h); fuera de pantalla no hace nada
   265                                  cursor:
   266 00000257 80FA50                      cmp dl, 80
   267 0000025A 7306                        jae .fuera
   268 0000025C 50                          push ax
   269 0000025D B402                        mov ah, 0x02
   270 0000025F CD10                        int 0x10
   271 00000261 58                          pop ax
   272                                  .fuera:
   273 00000262 C3                          ret
   274                                  
   275                                  ; poner_car: escribe AL con el color BL en DH:DL y avanza una columna.
   276                                  ; Si la columna pasa de 79 no escribe (recorte para la animación).
   277                                  poner_car:
   278 00000263 80FA50                      cmp dl, 80
   279 00000266 730B                        jae .recortar
   280 00000268 50                          push ax
   281 00000269 51                          push cx
   282 0000026A B409                        mov ah, 0x09
   283 0000026C B90100                      mov cx, 1
   284 0000026F CD10                        int 0x10
   285 00000271 59                          pop cx
   286 00000272 58                          pop ax
   287                                  .recortar:
   288 00000273 FEC2                        inc dl
   289 00000275 EBE0                        jmp cursor
   290                                  
   291                                  ; dibujar: interpreta el flujo DS:SI desde DH:DL (DL inicial = margen)
   292                                  dibujar:
   293 00000277 8816[A207]                  mov [margen], dl
   294 0000027B E8D9FF                      call cursor
   295                                  .siguiente:
   296 0000027E AC                          lodsb
   297 0000027F 84C0                        test al, al
   298 00000281 7427                        jz .fin
   299 00000283 781F                        js .color
   300 00000285 3C0A                        cmp al, NL
   301 00000287 7410                        je .nueva_linea
   302 00000289 3C20                        cmp al, ' '
   303 0000028B 7205                        jb .saltar
   304 0000028D E8D3FF                      call poner_car
   305 00000290 EBEC                        jmp .siguiente
   306                                  .saltar:
   307 00000292 00C2                        add dl, al
   308 00000294 E8C0FF                      call cursor
   309 00000297 EBE5                        jmp .siguiente
   310                                  .nueva_linea:
   311 00000299 FEC6                        inc dh
   312 0000029B 8A16[A207]                  mov dl, [margen]
   313 0000029F E8B5FF                      call cursor
   314 000002A2 EBDA                        jmp .siguiente
   315                                  .color:
   316 000002A4 247F                        and al, 0x7F
   317 000002A6 88C3                        mov bl, al
   318 000002A8 EBD4                        jmp .siguiente
   319                                  .fin:
   320 000002AA C3                          ret
   321                                  
   322                                  ; hex16 / hex8: escriben AX / AL en hexadecimal
   323                                  hex16:
   324 000002AB 50                          push ax
   325 000002AC 88E0                        mov al, ah
   326 000002AE E80100                      call hex8
   327 000002B1 58                          pop ax
   328                                  hex8:
   329 000002B2 50                          push ax
   330 000002B3 C0E804                      shr al, 4
   331 000002B6 E80900                      call .digito
   332 000002B9 58                          pop ax
   333 000002BA 50                          push ax
   334 000002BB 240F                        and al, 0x0F
   335 000002BD E80200                      call .digito
   336 000002C0 58                          pop ax
   337 000002C1 C3                          ret
   338                                  .digito:
   339 000002C2 0430                        add al, '0'
   340 000002C4 3C39                        cmp al, '9'
   341 000002C6 7602                        jbe .poner
   342 000002C8 0407                        add al, 7
   343                                  .poner:
   344 000002CA EB97                        jmp poner_car
   345                                  
   346                                  ; dec16: escribe AX en decimal
   347                                  dec16:
   348 000002CC 50                          push ax
   349 000002CD 51                          push cx
   350 000002CE 56                          push si
   351 000002CF 89D6                        mov si, dx                  ; DX se usa en la división: guardar el cursor
   352 000002D1 31C9                        xor cx, cx
   353                                  .dividir:
   354 000002D3 31D2                        xor dx, dx
   355 000002D5 F736[9F07]                  div word [diez]
   356 000002D9 52                          push dx                     ; resto = dígito
   357 000002DA 41                          inc cx
   358 000002DB 85C0                        test ax, ax
   359 000002DD 75F4                        jnz .dividir
   360 000002DF 89F2                        mov dx, si
   361                                  .escribir:
   362 000002E1 58                          pop ax
   363 000002E2 0430                        add al, '0'
   364 000002E4 E87CFF                      call poner_car
   365 000002E7 E2F8                        loop .escribir
   366 000002E9 5E                          pop si
   367 000002EA 59                          pop cx
   368 000002EB 58                          pop ax
   369 000002EC C3                          ret
   370                                  
   371                                  limpiar_galope:                 ; filas que ocupa el caballo en la animación
   372 000002ED 51                          push cx
   373 000002EE 52                          push dx
   374 000002EF B90005                      mov cx, (FILA_GALOPE << 8) | 0
   375 000002F2 BA4F12                      mov dx, ((FILA_GALOPE + 13) << 8) | 79
   376 000002F5 EB11                        jmp limpiar
   377                                  limpiar_pantalla:
   378 000002F7 51                          push cx
   379 000002F8 52                          push dx
   380 000002F9 31C9                        xor cx, cx
   381 000002FB BA4F18                      mov dx, 0x184F
   382 000002FE EB08                        jmp limpiar
   383                                  limpiar_respuesta:
   384 00000300 51                          push cx
   385 00000301 52                          push dx
   386 00000302 B90011                      mov cx, (FILA_MSG << 8) | 0
   387 00000305 BA4F17                      mov dx, (FILA_VOLVER << 8) | 79
   388                                  limpiar:                        ; borra la ventana CH:CL - DH:DL
   389 00000308 53                          push bx
   390 00000309 B80006                      mov ax, 0x0600
   391 0000030C B707                        mov bh, GRIS
   392 0000030E CD10                        int 0x10
   393 00000310 5B                          pop bx
   394 00000311 5A                          pop dx
   395 00000312 59                          pop cx
   396 00000313 C3                          ret
   397                                  
   398                                  ; esperar_ticks: espera CX ticks del temporizador del BIOS (~55 ms cada uno)
   399                                  esperar_ticks:
   400 00000314 50                          push ax
   401                                  .tick:
   402 00000315 A16C04                      mov ax, [0x046C]
   403                                  .mismo:
   404 00000318 F4                          hlt                         ; dormir hasta la próxima interrupción
   405 00000319 3B066C04                    cmp ax, [0x046C]
   406 0000031D 74F9                        je .mismo
   407 0000031F E2F4                        loop .tick
   408 00000321 58                          pop ax
   409 00000322 C3                          ret
